# Copy this file to .env and fill in your values
# Railway/Render set these automatically via their dashboard

# Required
DJANGO_SECRET_KEY=your-super-secret-key-here-change-this

# Set to 0 for production, 1 for development
DJANGO_DEBUG=0

# Comma-separated list of allowed hosts
# Railway gives you a domain like: yourapp.railway.app
ALLOWED_HOSTS=yourapp.railway.app,www.yourdomain.com

# PostgreSQL URL (Railway/Render sets this automatically when you add a DB)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=
